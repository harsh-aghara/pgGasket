{
	"compilerOptions": {
		"target": "ES2020",
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"]
}
